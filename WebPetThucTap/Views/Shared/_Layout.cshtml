<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pet App</title>
    <link rel="icon" type="image/png" href="~/Img/logo.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebPetThucTap.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-black border-bottom border-secondary box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-white fw-bold" asp-area="" asp-controller="Home" asp-action="Index">WebPetThucTap</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Htu">How to use</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Information">Pet's information</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Community">Community</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center">
                                @{
                                    var db = Context.Request.HttpContext.RequestServices.GetRequiredService<WebPetThucTap.Models.AppDbContext>();
                                    var userEmail = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value;
                                    var userAccount = !string.IsNullOrEmpty(userEmail) ? db.UserAccounts.Find(userEmail) : null;

                                    // Đọc link ảnh từ Google, nếu không có thì dùng ảnh mặc định
                                    var googleAvatar = User.Claims.FirstOrDefault(c => c.Type == "picture")?.Value;
                                    var avatarUrl = !string.IsNullOrEmpty(googleAvatar) ? googleAvatar : $"https://ui-avatars.com/api/?name={User.Identity.Name}&background=random&color=fff&rounded=true";
                                }

                                @if (userAccount != null && userAccount.Role >= WebPetThucTap.Models.UserRole.Admin)
                                {
                                    <a class="btn btn-sm btn-outline-warning me-4 fw-bold" asp-controller="Home" asp-action="Dashboard">
                                        <i class="bi bi-shield-lock"></i> Quản trị
                                    </a>
                                }

                                <div class="d-flex flex-column text-end me-3" style="width: 150px;">
                                    <div class="text-light fw-bold lh-1 mb-1 text-truncate">@User.Identity.Name</div>

                                    <div class="d-flex justify-content-end align-items-center mb-1">
                                        <small class="text-warning fw-bold" style="font-size: 0.70rem;">
                                            👑 @(ViewData["UserTitle"] ?? "Tân binh")
                                        </small>
                                    </div>
                                    <div class="d-flex justify-content-end align-items-center mb-1">
                                        @if (ViewData["CurrentExp"] != null && ViewData["NextExp"] != null)
                                        {
                                            <small class="text-muted" style="font-size: 0.65rem;">
                                                @ViewData["CurrentExp"] / @ViewData["NextExp"]
                                            </small>
                                        }
                                    </div>

                                    @if (ViewData["CurrentExp"] != null && ViewData["NextExp"] != null)
                                    {
                                        <div class="progress" style="height: 5px; background-color: #333;" title="@ViewData["CurrentExp"] / @ViewData["NextExp"] EXP">
                                            <div class="progress-bar bg-warning progress-bar-striped progress-bar-animated"
                                                 role="progressbar"
                                                 style="width: @ViewData["ExpPercent"]%;">
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="d-flex flex-column align-items-center justify-content-center">
                                    <img src="@avatarUrl"
                                         alt="Avatar" width="34" height="34" class="rounded-circle shadow-sm mb-1" referrerPolicy="no-referrer" />

                                    <a class="btn btn-outline-danger btn-sm rounded-pill" style="font-size: 0.60rem; padding: 0.15rem 0.5rem;" asp-controller="Account" asp-action="Logout">
                                        Đăng xuất
                                    </a>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-light text-dark fw-bold rounded-pill px-3 shadow-sm" asp-controller="Account" asp-action="LoginWithGoogle">
                                    Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-secondary footer text-light bg-black">
        <div class="container">
            We hope you have a pleasant experience. Please contact us using the information provided. <a asp-area="" asp-controller="Home" asp-action="Contact" class="text-info">Contact</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>