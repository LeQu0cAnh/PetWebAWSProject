@{
    ViewData["Title"] = "How To Use";
}

<div class="container mt-5">
    <h2 class="text-info fw-bold border-bottom border-secondary pb-2">Pet Care Guide</h2>
    <p class="text-light mt-3">With just 3 simple steps, you can get familiar with your new on-screen companion.</p>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card bg-dark border-secondary shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="card-title text-warning fw-bold">1. Basic Interaction</h5>
                    <p class="card-text text-secondary">Left-click to drag and drop your Pet anywhere on the screen. Right-click to open the quick settings menu.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-secondary shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="card-title text-warning fw-bold">2. AI Chat</h5>
                    <p class="card-text text-secondary">Double-click the Pet to open the chatbox. You can ask questions, request text summaries, or just hang out.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-secondary shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="card-title text-warning fw-bold">3. Health Mode</h5>
                    <p class="card-text text-secondary">Enable "Focus Mode" in settings. Your Pet will gently nudge you to drink water and fix your posture every 45 minutes.</p>
                </div>
            </div>
        </div>
    </div>
</div>