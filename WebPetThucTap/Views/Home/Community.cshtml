@model IEnumerable<WebPetThucTap.Models.Topic>
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "Community Forum";
    var activeTopic = ViewBag.ActiveTopic as WebPetThucTap.Models.Topic;
    // Lấy thông tin quyền của người đang đăng nhập từ ViewBag (do Controller ném qua)
    var currentUserRole = ViewBag.CurrentUserRole != null ? (WebPetThucTap.Models.UserRole)ViewBag.CurrentUserRole : WebPetThucTap.Models.UserRole.User;
    var currentUserEmail = User.Identity.IsAuthenticated ? User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value : "";
    var likedElements = ViewBag.LikedElements as List<int> ?? new List<int>();
    var topicLikesCount = ViewBag.TopicLikesCount as Dictionary<int, int> ?? new Dictionary<int, int>();
    var commentLikesCount = ViewBag.CommentLikesCount as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card bg-dark border-secondary shadow">
                <div class="card-header bg-black border-bottom border-secondary d-flex justify-content-between align-items-center py-2">
                    <h5 class="text-info mb-0 fw-bold">Topics</h5>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <button class="btn btn-sm btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#newTopicModal">+ New</button>
                    }
                </div>
                <div class="list-group list-group-flush" style="max-height: 75vh; overflow-y: auto;">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            bool isActive = activeTopic != null && item.Id == activeTopic.Id;
                            <a asp-action="Community" asp-route-id="@item.Id"
                               class="list-group-item list-group-item-action bg-dark text-light border-secondary @(isActive ? "active-topic" : "")">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1 fw-bold text-truncate" style="max-width: 130px;">
                                        @if (!item.IsApproved)
                                        {
                                            <span class="badge bg-warning text-dark me-1">Chờ duyệt</span>
                                        }
                                        @item.Title
                                    </h6>
                                    <small class="text-warning">
                                        @{
                                            int sidebarLikes = topicLikesCount.ContainsKey(item.Id) ? topicLikesCount[item.Id] : 0;
                                        }
                                        @item.Comments.Count <i class="bi bi-chat-dots"></i> • @sidebarLikes <i class="bi bi-heart-fill text-danger"></i>
                                    </small>
                                </div>
                                <small class="text-muted">Bởi @item.AuthorName • @item.CreatedAt.ToString("dd/MM HH:mm")</small>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted"><small>Chưa có chủ đề nào.</small></div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-9">
            @if (!User.Identity.IsAuthenticated)
            {
                <div class="alert bg-secondary bg-opacity-25 border border-secondary text-light mb-4">
                    <i class="bi bi-info-circle me-2"></i> Bạn cần <a href="/Account/LoginWithGoogle" class="text-info fw-bold">Đăng nhập bằng Google</a> để tương tác.
                </div>
            }

            @if (activeTopic != null)
            {
                <div class="card bg-dark border-secondary shadow mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center">
                                <img src="https://ui-avatars.com/api/?name=@activeTopic.AuthorName&background=random" class="rounded-circle me-3" width="50" height="50">
                                <div>
                                    <h4 class="text-white mb-0 fw-bold">@activeTopic.Title</h4>
                                    <small class="text-muted">Đăng bởi <strong class="text-info">@activeTopic.AuthorName</strong> lúc @activeTopic.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</small>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    bool isLiked = likedElements.Contains(-activeTopic.Id);
                                    // Lấy số đếm Like của Topic hiện tại, nếu không có thì mặc định là 0
                                    int tLikes = topicLikesCount.ContainsKey(activeTopic.Id) ? topicLikesCount[activeTopic.Id] : 0;

                                    <form asp-action="ToggleLikeTopic" method="post">
                                        <input type="hidden" name="topicId" value="@activeTopic.Id" />
                                        <button type="submit" class="btn btn-sm @(isLiked ? "btn-danger" : "btn-outline-danger") rounded-pill fw-bold">
                                            <i class="bi @(isLiked ? "bi-heart-fill" : "bi-heart")"></i> Like (@tLikes)
                                        </button>
                                    </form>
                                }

                                @if (!activeTopic.IsApproved && (currentUserRole == WebPetThucTap.Models.UserRole.Admin || currentUserRole == WebPetThucTap.Models.UserRole.Dev))
                                {
                                    <form asp-action="ApproveTopic" method="post">
                                        <input type="hidden" name="id" value="@activeTopic.Id" />
                                        <button type="submit" class="btn btn-sm btn-success fw-bold"><i class="bi bi-check-circle"></i> Duyệt bài</button>
                                    </form>
                                }

                                @if (currentUserEmail == activeTopic.AuthorEmail || currentUserRole == WebPetThucTap.Models.UserRole.Admin || currentUserRole == WebPetThucTap.Models.UserRole.Dev)
                                {
                                    <form asp-action="DeleteTopic" method="post" onsubmit="return confirm('Bạn chắc chắn muốn xóa bài viết này?')">
                                        <input type="hidden" name="id" value="@activeTopic.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Xóa bài</button>
                                    </form>
                                }
                            </div>
                        </div>

                        <p class="text-light fs-5 mt-3" style="white-space: pre-line;">@activeTopic.Content</p>

                        @if (!string.IsNullOrEmpty(activeTopic.MediaUrl))
                        {
                            <div class="mt-3 text-center bg-black bg-opacity-50 p-2 rounded border border-secondary">
                                <img src="@activeTopic.MediaUrl" class="img-fluid rounded" style="max-height: 350px;" alt="Đính kèm" />
                            </div>
                        }
                    </div>

                    <div class="card-footer bg-black border-secondary">
                        <h5 class="text-white mb-3 fw-bold">Bình luận (@activeTopic.Comments.Count)</h5>

                        <div class="comment-list" style="max-height: 35vh; overflow-y: auto;">
                            @foreach (var c in activeTopic.Comments.OrderBy(x => x.CreatedAt))
                            {
                                <div class="d-flex mb-3 align-items-start">
                                    <div class="dropdown">
                                        <img src="https://ui-avatars.com/api/?name=@c.AuthorName&background=random"
                                             class="rounded-circle me-3 dropdown-toggle" style="cursor:pointer" data-bs-toggle="dropdown" width="40" height="40">

                                        @if (currentUserRole == WebPetThucTap.Models.UserRole.Admin || currentUserRole == WebPetThucTap.Models.UserRole.Dev)
                                        {
                                            <ul class="dropdown-menu bg-dark text-light border-secondary">
                                                <li class="dropdown-header text-info">Quản lý: @c.AuthorName</li>
                                                <li><a class="dropdown-item text-warning" href="#" onclick="openBanModal('@c.AuthorEmail')"><i class="bi bi-ban"></i> Ban Người Dùng</a></li>

                                                @if (currentUserRole == WebPetThucTap.Models.UserRole.Dev)
                                                {
                                                    <li><hr class="dropdown-divider border-secondary"></li>
                                                    <li><a class="dropdown-item text-success" asp-action="PromoteToAdmin" asp-route-email="@c.AuthorEmail"><i class="bi bi-arrow-up-circle"></i> Lên Admin</a></li>
                                                    <li><a class="dropdown-item text-danger" asp-action="DemoteToUser" asp-route-email="@c.AuthorEmail"><i class="bi bi-arrow-down-circle"></i> Hạ xuống User</a></li>
                                                }
                                            </ul>
                                        }
                                    </div>

                                    <div class="bg-secondary bg-opacity-25 p-3 rounded w-100 border border-secondary">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong class="text-warning me-2">@c.AuthorName</strong>
                                                @if (c.IsEdited)
                                                {
                                                    <span class="badge bg-dark border border-secondary text-muted" style="cursor:pointer" onclick="viewHistory(@c.Id)">
                                                        Đã chỉnh sửa <i class="bi bi-clock-history"></i>
                                                    </span>
                                                }
                                            </div>
                                            <div class="d-flex align-items-center gap-3">
                                                <small class="text-muted">@c.CreatedAt.ToString("HH:mm dd/MM")</small>

                                                <div class="dropdown">
                                                    <i class="bi bi-three-dots text-muted" style="cursor:pointer" data-bs-toggle="dropdown"></i>
                                                    <ul class="dropdown-menu dropdown-menu-end bg-dark border-secondary">
                                                        @if (currentUserEmail == c.AuthorEmail)
                                                        {
                                                            <li><a class="dropdown-item text-light" href="#" onclick="editComment(@c.Id, '@JavaScriptEncoder.Default.Encode(c.Content)')"><i class="bi bi-pencil"></i> Sửa bình luận</a></li>
                                                        }
                                                        @if (currentUserEmail == c.AuthorEmail || currentUserRole == WebPetThucTap.Models.UserRole.Admin || currentUserRole == WebPetThucTap.Models.UserRole.Dev)
                                                        {
                                                            <li>
                                                                <form asp-action="DeleteComment" method="post" onsubmit="return confirm('Xóa bình luận này?')">
                                                                    <input type="hidden" name="id" value="@c.Id" />
                                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash"></i> Xóa bình luận</button>
                                                                </form>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>

                                        <p id="comment-text-@c.Id" class="text-light mb-0 mt-1" style="white-space: pre-line;">@c.Content</p>

                                        @if (User.Identity.IsAuthenticated)
                                        {
                                            bool isCIdLiked = likedElements.Contains(c.Id);
                                            // Lấy số đếm Like của Comment hiện tại
                                            int cLikes = commentLikesCount.ContainsKey(c.Id) ? commentLikesCount[c.Id] : 0;

                                            <form asp-action="ToggleLikeComment" method="post" class="mt-2">
                                                <input type="hidden" name="commentId" value="@c.Id" />
                                                <button type="submit" class="btn btn-sm py-0 px-2 @(isCIdLiked ? "text-danger" : "text-muted") fw-bold" style="font-size:0.85rem;">
                                                    <i class="bi @(isCIdLiked ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-up")"></i> Thích (@cLikes)
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <form asp-action="CreateComment" method="post" class="mt-4">
                                <input type="hidden" name="topicId" value="@activeTopic.Id" />
                                <div class="mb-2">
                                    <textarea name="content" class="form-control bg-dark text-light border-secondary mb-2" rows="2" placeholder="Viết bình luận của bạn..." required></textarea>
                                    <button type="submit" class="btn btn-info fw-bold text-dark">Gửi bình luận</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card bg-dark border-secondary text-center p-5 shadow">
                    <h5 class="text-muted mb-0">Chưa có bài thảo luận nào được tạo hoặc đang đợi duyệt.</h5>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="newTopicModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form asp-action="CreateTopic" method="post" class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header bg-black border-bottom border-secondary">
                <h5 class="modal-title text-info fw-bold">Tạo bài viết mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-white fw-bold">Tiêu đề bài viết</label>
                    <input type="text" name="title" class="form-control bg-black text-white border-secondary" placeholder="Nhập tiêu đề ngắn gọn..." required />
                </div>
                <div class="mb-3">
                    <label class="form-label text-white fw-bold">Nội dung chi tiết (Có thể nhấn Ctrl + V để dán nhanh ảnh)</label>
                    <textarea id="topicContent" name="content" class="form-control bg-black text-white border-secondary" rows="5" placeholder="Bạn muốn thảo luận điều gì..." required></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label text-white fw-bold">Hình ảnh đính kèm</label>
                    <input type="file" id="imageInput" class="form-control bg-black text-white border-secondary" accept="image/*" />
                    <input type="hidden" id="mediaUrlHidden" name="mediaUrl" />
                    <div id="imagePreviewContainer" class="mt-3 text-center d-none position-relative bg-black rounded p-2 border border-secondary">
                        <img id="imagePreview" src="#" class="img-fluid rounded" style="max-height: 250px;" alt="Preview" />
                        <button type="button" id="btnRemoveImage" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 rounded-circle">×</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-black border-top border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-primary fw-bold px-4">Đăng bài gửi duyệt</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editCommentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="EditComment" method="post" class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header bg-black border-bottom border-secondary">
                <h5 class="modal-title text-warning fw-bold">Chỉnh sửa bình luận</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editCommentId" name="commentId" />
                <textarea id="editCommentContent" name="newContent" class="form-control bg-black text-white border-secondary" rows="3" required></textarea>
            </div>
            <div class="modal-footer bg-black border-top border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-warning text-dark fw-bold">Cập nhật</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="banUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="BanUser" method="post" class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header bg-black border-bottom border-secondary">
                <h5 class="modal-title text-danger fw-bold"><i class="bi bi-shield-slash"></i> Khóa tài khoản thành viên</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="banUserEmail" name="userEmail" />
                <div class="mb-3">
                    <label class="form-label text-white">Chọn thời gian khóa bình luận:</label>
                    <select name="hours" class="form-select bg-black text-white border-secondary">
                        <option value="2">2 Giờ</option>
                        <option value="24">24 Giờ (1 Ngày)</option>
                        <option value="168">7 Ngày (1 Tuần)</option>
                        <option value="720">30 Ngày (1 Tháng)</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer bg-black border-top border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-danger fw-bold">Thi hành lệnh Ban</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header bg-black border-bottom border-secondary">
                <h5 class="modal-title text-muted fw-bold"><i class="bi bi-clock-history"></i> Lịch sử chỉnh sửa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div id="historyModalBody" class="modal-body" style="max-height:60vh; overflow-y:auto;">
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        // JS xử lý tải ảnh / paste ảnh cũ của bạn được giữ nguyên
        const imageInput = document.getElementById('imageInput');
        const mediaUrlHidden = document.getElementById('mediaUrlHidden');
        const imagePreviewContainer = document.getElementById('imagePreviewContainer');
        const imagePreview = document.getElementById('imagePreview');
        const btnRemoveImage = document.getElementById('btnRemoveImage');
        const topicContent = document.getElementById('topicContent');

        function handleImageFile(file) {
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    imagePreview.src = e.target.result;
                    imagePreviewContainer.classList.remove('d-none');
                    mediaUrlHidden.value = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }
        imageInput.addEventListener('change', function (e) { handleImageFile(e.target.files[0]); });
        topicContent.addEventListener('paste', function (e) {
            const items = (e.clipboardData || e.originalEvent.clipboardData).items;
            for (let i = 0; i < items.length; i++) {
                if (items[i].type.indexOf('image') !== -1) {
                    const blob = items[i].getAsFile();
                    handleImageFile(blob);
                    e.preventDefault();
                    break;
                }
            }
        });
        btnRemoveImage.addEventListener('click', function () {
            imageInput.value = ''; mediaUrlHidden.value = ''; imagePreview.src = '#'; imagePreviewContainer.classList.add('d-none');
        });

        // ====== THÊM MỚI: CÁC HÀM JAVASCRIPT ĐIỀU KHIỂN MODAL CHỨC NĂNG PHÂN QUYỀN ======

        function editComment(id, oldContent) {
            document.getElementById('editCommentId').value = id;
            document.getElementById('editCommentContent').value = oldContent;
            new bootstrap.Modal(document.getElementById('editCommentModal')).show();
        }

        function openBanModal(email) {
            document.getElementById('banUserEmail').value = email;
            new bootstrap.Modal(document.getElementById('banUserModal')).show();
        }

        // Gọi API nạp lịch sử sửa đổi không làm lag trang (AJAX)
        function viewHistory(commentId) {
            const body = document.getElementById('historyModalBody');
            body.innerHTML = '<div class="text-center text-muted p-3">Đang tải lịch sử...</div>';
            new bootstrap.Modal(document.getElementById('historyModal')).show();

            fetch(`/Home/GetCommentHistory?commentId=${commentId}`)
                .then(res => res.json())
                .then(data => {
                    if(data.length === 0) {
                        body.innerHTML = '<div class="text-center text-muted">Không tìm thấy dữ liệu.</div>';
                        return;
                    }
                    let html = '';
                    data.forEach(h => {
                        html += `
                            <div class="border-bottom border-secondary pb-2 mb-2">
                                <div class="text-muted mb-1" style="font-size:0.8rem;"><i class="bi bi-calendar3"></i> Sửa vào: ${h.editedAt}</div>
                                <div class="text-light-50 bg-black bg-opacity-30 p-2 rounded small" style="white-space: pre-line;">${h.oldContent}</div>
                            </div>`;
                    });
                    body.innerHTML = html;
                });
        }
    </script>
}

<style>
    .active-topic {
        background-color: rgba(13, 110, 253, 0.2) !important;
        border-left: 4px solid #0dcaf0 !important;
    }
</style>