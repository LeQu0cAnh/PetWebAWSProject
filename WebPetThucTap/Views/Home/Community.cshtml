@model IEnumerable<WebPetThucTap.Models.Topic>
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "Community Forum";
    var activeTopic = ViewBag.ActiveTopic as WebPetThucTap.Models.Topic;
    var currentUserRole = ViewBag.CurrentUserRole != null ? (WebPetThucTap.Models.UserRole)ViewBag.CurrentUserRole : WebPetThucTap.Models.UserRole.User;
    var currentUserEmail = User.Identity?.IsAuthenticated == true ? User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value : "";
    var likedElements = ViewBag.LikedElements as List<int> ?? new List<int>();
    var topicLikesCount = ViewBag.TopicLikesCount as Dictionary<int, int> ?? new Dictionary<int, int>();
    var commentLikesCount = ViewBag.CommentLikesCount as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="forum-container">
    <div class="container-fluid px-3 px-md-4 py-4">
        <div class="row g-4">
            <!-- Sidebar - Topics List -->
            <div class="col-lg-3 col-md-4">
                <div class="sidebar-card rounded-4 overflow-hidden">
                    <div class="sidebar-header d-flex justify-content-between align-items-center p-3">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-chat-square-text me-2 text-info"></i>Topics
                        </h5>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button class="btn btn-sm btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#newTopicModal">
                                <i class="bi bi-plus-lg me-1"></i>New
                            </button>
                        }
                    </div>
                    <div class="topics-list">
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                bool isActive = activeTopic != null && item.Id == activeTopic.Id;
                                <a asp-action="Community" asp-route-id="@item.Id"
                                   class="topic-item d-block p-3 @(isActive ? "active" : "")">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1 me-2">
                                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                                @if (!item.IsApproved)
                                                {
                                                    <span class="badge bg-warning bg-opacity-25 text-warning px-2 py-1 rounded-pill fs-10">Pending</span>
                                                }
                                                <h6 class="mb-0 fw-semibold text-truncate">@item.Title</h6>
                                            </div>
                                            <div class="d-flex gap-3 mt-1">
                                                <small class="text-muted"><i class="bi bi-person-circle me-1"></i>@item.AuthorName</small>
                                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@item.CreatedAt.ToString("dd/MM HH:mm")</small>
                                            </div>
                                        </div>
                                        <div class="stats-badge text-end">
                                            <div class="small"><i class="bi bi-chat-dots text-secondary me-1"></i>@item.Comments.Count</div>
                                            <div class="small"><i class="bi bi-heart-fill text-danger me-1"></i>@(topicLikesCount.ContainsKey(item.Id) ? topicLikesCount[item.Id] : 0)</div>
                                        </div>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-chat-square-text fs-1 text-muted"></i>
                                <p class="text-muted mt-2 mb-0">No topics yet.<br>Be the first to start a discussion!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Main Content - Active Topic -->
            <div class="col-lg-9 col-md-8">
                @if (!User.Identity?.IsAuthenticated == true)
                {
                    <div class="alert-card mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        You need <a href="/Account/LoginWithGoogle" class="alert-link">Login with Google</a> to interact with the community.
                    </div>
                }

                @if (activeTopic != null)
                {
                    <div class="topic-detail-card rounded-4 overflow-hidden">
                        <!-- Topic Header -->
                        <div class="topic-header p-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                                <div class="d-flex gap-3">
                                    <img src="https://ui-avatars.com/api/?name=@activeTopic.AuthorName&background=0d6efd&color=fff&bold=true&rounded=true&size=48"
                                         class="rounded-circle" width="52" height="52">
                                    <div>
                                        <h3 class="mb-1 fw-bold">@activeTopic.Title</h3>
                                        <div class="d-flex flex-wrap gap-3">
                                            <small class="text-muted"><i class="bi bi-person-circle me-1"></i>@activeTopic.AuthorName</small>
                                            <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@activeTopic.CreatedAt.ToString("MMMM dd, yyyy - HH:mm")</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex gap-2">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        bool isLiked = likedElements.Contains(-activeTopic.Id);
                                        int tLikes = topicLikesCount.ContainsKey(activeTopic.Id) ? topicLikesCount[activeTopic.Id] : 0;
                                        <form asp-action="ToggleLikeTopic" method="post" class="d-inline">
                                            <input type="hidden" name="topicId" value="@activeTopic.Id" />
                                            <button type="submit" class="btn-like @(isLiked ? "liked" : "")">
                                                <i class="bi @(isLiked ? "bi-heart-fill" : "bi-heart") me-1"></i>
                                                @tLikes
                                            </button>
                                        </form>
                                    }

                                    @if (!activeTopic.IsApproved && (currentUserRole == WebPetThucTap.Models.UserRole.Admin || currentUserRole == WebPetThucTap.Models.UserRole.Dev))
                                    {
                                        <form asp-action="ApproveTopic" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@activeTopic.Id" />
                                            <button type="submit" class="btn-approve"><i class="bi bi-check-circle me-1"></i>Approve</button>
                                        </form>
                                    }

                                    @if (currentUserEmail == activeTopic.AuthorEmail || currentUserRole == WebPetThucTap.Models.UserRole.Admin || currentUserRole == WebPetThucTap.Models.UserRole.Dev)
                                    {
                                        <form asp-action="DeleteTopic" method="post" onsubmit="return confirm('Delete this topic permanently?')" class="d-inline">
                                            <input type="hidden" name="id" value="@activeTopic.Id" />
                                            <button type="submit" class="btn-delete"><i class="bi bi-trash3 me-1"></i>Delete</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Topic Content -->
                        <div class="topic-body p-4 border-top border-bottom border-secondary border-opacity-25">
                            <p class="fs-5 mb-0" style="white-space: pre-line;">@activeTopic.Content</p>
                            @if (!string.IsNullOrEmpty(activeTopic.MediaUrl))
                            {
                                <div class="topic-media mt-4">
                                    <img src="@activeTopic.MediaUrl" class="img-fluid rounded-3" alt="Attachment" />
                                </div>
                            }
                        </div>

                        <!-- Comments Section -->
                        <div class="comments-section p-4">
                            <h5 class="mb-3 fw-semibold">
                                <i class="bi bi-chat-dots me-2 text-info"></i>
                                Comments (@activeTopic.Comments.Count)
                            </h5>

                            <div class="comments-list mb-4">
                                @foreach (var c in activeTopic.Comments.OrderBy(x => x.CreatedAt))
                                {
                                    <div class="comment-item mb-3">
                                        <div class="d-flex gap-3">
                                            <div class="comment-avatar">
                                                <img src="https://ui-avatars.com/api/?name=@c.AuthorName&background=6c757d&color=fff&rounded=true&size=36"
                                                     class="rounded-circle" width="40" height="40">
                                            </div>
                                            <div class="comment-bubble flex-grow-1">
                                                <div class="comment-header d-flex flex-wrap justify-content-between align-items-center">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <strong class="text-info">@c.AuthorName</strong>
                                                        @if (c.IsEdited)
                                                        {
                                                            <span class="badge bg-dark text-muted rounded-pill" style="cursor:pointer; font-size:10px;" onclick="viewHistory(@c.Id)">
                                                                <i class="bi bi-clock-history"></i> Edited
                                                            </span>
                                                        }
                                                    </div>
                                                    <div class="d-flex align-items-center gap-3">
                                                        <small class="text-muted">@c.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</small>
                                                        <div class="dropdown">
                                                            <i class="bi bi-three-dots-vertical text-muted" style="cursor:pointer" data-bs-toggle="dropdown"></i>
                                                            <ul class="dropdown-menu dropdown-menu-end bg-dark border-secondary">
                                                                @if (currentUserEmail == c.AuthorEmail)
                                                                {
                                                                    <li><a class="dropdown-item text-light" href="#" onclick="editComment(@c.Id, '@JavaScriptEncoder.Default.Encode(c.Content ?? "")')"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                                                                }
                                                                @if (currentUserEmail == c.AuthorEmail || currentUserRole == WebPetThucTap.Models.UserRole.Admin || currentUserRole == WebPetThucTap.Models.UserRole.Dev)
                                                                {
                                                                    <li>
                                                                        <form asp-action="DeleteComment" method="post" onsubmit="return confirm('Delete this comment?')">
                                                                            <input type="hidden" name="id" value="@c.Id" />
                                                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash3 me-2"></i>Delete</button>
                                                                        </form>
                                                                    </li>
                                                                }
                                                                @if (currentUserRole == WebPetThucTap.Models.UserRole.Admin || currentUserRole == WebPetThucTap.Models.UserRole.Dev)
                                                                {
                                                                    <li><hr class="dropdown-divider border-secondary"></li>
                                                                    <li><a class="dropdown-item text-warning" href="#" onclick="openBanModal('@c.AuthorEmail')"><i class="bi bi-ban me-2"></i>Ban User</a></li>
                                                                    @if (currentUserRole == WebPetThucTap.Models.UserRole.Dev)
                                                                    {
                                                                        <li><a class="dropdown-item text-success" asp-action="PromoteToAdmin" asp-route-email="@c.AuthorEmail"><i class="bi bi-arrow-up-circle me-2"></i>Promote to Admin</a></li>
                                                                        <li><a class="dropdown-item text-danger" asp-action="DemoteToUser" asp-route-email="@c.AuthorEmail"><i class="bi bi-arrow-down-circle me-2"></i>Demote to User</a></li>
                                                                    }
                                                                }
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                                <p id="comment-text-@c.Id" class="comment-text mb-2 mt-2">@c.Content</p>
                                                @if (User.Identity?.IsAuthenticated == true)
                                                {
                                                    bool isCIdLiked = likedElements.Contains(c.Id);
                                                    int cLikes = commentLikesCount.ContainsKey(c.Id) ? commentLikesCount[c.Id] : 0;
                                                    <form asp-action="ToggleLikeComment" method="post" class="d-inline">
                                                        <input type="hidden" name="commentId" value="@c.Id" />
                                                        <button type="submit" class="btn-like-comment @(isCIdLiked ? "liked" : "")">
                                                            <i class="bi @(isCIdLiked ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-up") me-1"></i>
                                                            @cLikes
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-action="CreateComment" method="post" class="comment-form mt-3">
                                    <input type="hidden" name="topicId" value="@activeTopic.Id" />
                                    <div class="d-flex gap-3">
                                        <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&background=0d6efd&color=fff&rounded=true&size=32"
                                             class="rounded-circle" width="36" height="36">
                                        <div class="flex-grow-1">
                                            <textarea name="content" class="form-control bg-dark text-light border-secondary rounded-3" rows="2" placeholder="Write a comment..." required></textarea>
                                            <div class="mt-2 text-end">
                                                <button type="submit" class="btn-submit-comment">
                                                    <i class="bi bi-send me-1"></i> Post Comment
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="empty-state rounded-4 text-center py-5">
                        <i class="bi bi-chat-square-text fs-1 text-muted d-block mb-3"></i>
                        <h5 class="text-muted mb-0">Select a topic from the sidebar to view discussion</h5>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modals (unchanged, kept original functionality) -->
<div class="modal fade" id="newTopicModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form asp-action="CreateTopic" method="post" class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header bg-black border-bottom border-secondary">
                <h5 class="modal-title text-info fw-bold"><i class="bi bi-plus-circle me-2"></i>Create New Topic</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-white fw-semibold">Title</label>
                    <input type="text" name="title" class="form-control bg-black text-white border-secondary" placeholder="Enter a descriptive title..." required />
                </div>
                <div class="mb-3">
                    <label class="form-label text-white fw-semibold">Content (Ctrl+V to paste image)</label>
                    <textarea id="topicContent" name="content" class="form-control bg-black text-white border-secondary" rows="5" placeholder="Share your thoughts..." required></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label text-white fw-semibold">Attach Image</label>
                    <input type="file" id="imageInput" class="form-control bg-black text-white border-secondary" accept="image/*" />
                    <input type="hidden" id="mediaUrlHidden" name="mediaUrl" />
                    <div id="imagePreviewContainer" class="mt-3 text-center d-none bg-black rounded p-2 border border-secondary">
                        <img id="imagePreview" src="#" class="img-fluid rounded" style="max-height: 200px;" />
                        <button type="button" id="btnRemoveImage" class="btn btn-danger btn-sm rounded-circle mt-2">× Remove</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-black border-top border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary fw-bold px-4">Submit for Review</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editCommentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="EditComment" method="post" class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header bg-black border-bottom border-secondary">
                <h5 class="modal-title text-warning fw-bold">Edit Comment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editCommentId" name="commentId" />
                <textarea id="editCommentContent" name="newContent" class="form-control bg-black text-white border-secondary" rows="3" required></textarea>
            </div>
            <div class="modal-footer bg-black border-top border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-warning text-dark fw-bold">Update</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="banUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="BanUser" method="post" class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header bg-black border-bottom border-secondary">
                <h5 class="modal-title text-danger fw-bold"><i class="bi bi-shield-slash me-2"></i>Ban User</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="banUserEmail" name="userEmail" />
                <label class="form-label text-white">Ban duration:</label>
                <select name="hours" class="form-select bg-black text-white border-secondary">
                    <option value="2">2 Hours</option>
                    <option value="24">24 Hours (1 Day)</option>
                    <option value="168">7 Days (1 Week)</option>
                    <option value="720">30 Days (1 Month)</option>
                </select>
            </div>
            <div class="modal-footer bg-black border-top border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger fw-bold">Ban User</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header bg-black border-bottom border-secondary">
                <h5 class="modal-title"><i class="bi bi-clock-history me-2"></i>Edit History</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div id="historyModalBody" class="modal-body" style="max-height:60vh; overflow-y:auto;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const imageInput = document.getElementById('imageInput');
        const mediaUrlHidden = document.getElementById('mediaUrlHidden');
        const imagePreviewContainer = document.getElementById('imagePreviewContainer');
        const imagePreview = document.getElementById('imagePreview');
        const btnRemoveImage = document.getElementById('btnRemoveImage');
        const topicContent = document.getElementById('topicContent');

        function handleImageFile(file) {
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    imagePreview.src = e.target.result;
                    imagePreviewContainer.classList.remove('d-none');
                    mediaUrlHidden.value = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }
        imageInput.addEventListener('change', function (e) { handleImageFile(e.target.files[0]); });
        topicContent.addEventListener('paste', function (e) {
            const items = (e.clipboardData || e.originalEvent.clipboardData).items;
            for (let i = 0; i < items.length; i++) {
                if (items[i].type.indexOf('image') !== -1) {
                    const blob = items[i].getAsFile();
                    handleImageFile(blob);
                    e.preventDefault();
                    break;
                }
            }
        });
        btnRemoveImage.addEventListener('click', function () {
            imageInput.value = ''; mediaUrlHidden.value = ''; imagePreview.src = '#'; imagePreviewContainer.classList.add('d-none');
        });

        function editComment(id, oldContent) {
            document.getElementById('editCommentId').value = id;
            document.getElementById('editCommentContent').value = oldContent;
            new bootstrap.Modal(document.getElementById('editCommentModal')).show();
        }

        function openBanModal(email) {
            document.getElementById('banUserEmail').value = email;
            new bootstrap.Modal(document.getElementById('banUserModal')).show();
        }

        function viewHistory(commentId) {
            const body = document.getElementById('historyModalBody');
            body.innerHTML = '<div class="text-center text-muted p-3">Loading history...</div>';
            new bootstrap.Modal(document.getElementById('historyModal')).show();
            fetch(`/Home/GetCommentHistory?commentId=${commentId}`)
                .then(res => res.json())
                .then(data => {
                    if(data.length === 0) {
                        body.innerHTML = '<div class="text-center text-muted">No edit history found.</div>';
                        return;
                    }
                    let html = '';
                    data.forEach(h => {
                        html += `<div class="border-bottom border-secondary pb-2 mb-2">
                                    <div class="text-muted mb-1 small"><i class="bi bi-calendar3"></i> Edited: ${h.editedAt}</div>
                                    <div class="bg-black bg-opacity-30 p-2 rounded small">${h.oldContent}</div>
                                </div>`;
                    });
                    body.innerHTML = html;
                });
        }
    </script>
}

<style>
    /* Forum Container Styles - Professional & Clean */
    .forum-container {
        background: transparent;
        min-height: calc(100vh - 200px);
    }

    /* Sidebar Card */
    .sidebar-card {
        background: rgba(20, 20, 30, 0.6);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .sidebar-header {
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(0, 0, 0, 0.3);
    }

    .topics-list {
        max-height: 70vh;
        overflow-y: auto;
    }

    .topic-item {
        transition: all 0.2s ease;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        text-decoration: none;
    }

    .topic-item:hover {
        background: rgba(13, 202, 240, 0.08);
    }

    .topic-item.active {
        background: linear-gradient(90deg, rgba(13, 110, 253, 0.15), transparent);
        border-left: 3px solid #0dcaf0;
    }

    .stats-badge {
        font-size: 0.75rem;
        min-width: 55px;
    }

    /* Alert Card */
    .alert-card {
        background: rgba(13, 202, 240, 0.08);
        border: 1px solid rgba(13, 202, 240, 0.2);
        border-radius: 16px;
        padding: 1rem 1.25rem;
        color: #adb5bd;
    }

    .alert-card .alert-link {
        color: #0dcaf0;
        text-decoration: none;
        font-weight: 600;
    }

    /* Topic Detail Card */
    .topic-detail-card {
        background: rgba(20, 20, 30, 0.6);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .topic-header {
        background: rgba(0, 0, 0, 0.2);
    }

    /* Buttons */
    .btn-like, .btn-like-comment {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 30px;
        padding: 0.35rem 1rem;
        font-size: 0.85rem;
        font-weight: 500;
        color: #adb5bd;
        transition: all 0.2s;
    }

    .btn-like:hover, .btn-like-comment:hover {
        background: rgba(220, 53, 69, 0.15);
        border-color: rgba(220, 53, 69, 0.4);
        color: #dc3545;
    }

    .btn-like.liked, .btn-like-comment.liked {
        background: rgba(220, 53, 69, 0.2);
        border-color: #dc3545;
        color: #dc3545;
    }

    .btn-approve {
        background: rgba(25, 135, 84, 0.15);
        border: 1px solid rgba(25, 135, 84, 0.3);
        border-radius: 30px;
        padding: 0.35rem 1rem;
        font-size: 0.85rem;
        font-weight: 500;
        color: #198754;
        transition: all 0.2s;
    }

    .btn-approve:hover {
        background: #198754;
        color: white;
    }

    .btn-delete {
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid rgba(220, 53, 69, 0.3);
        border-radius: 30px;
        padding: 0.35rem 1rem;
        font-size: 0.85rem;
        font-weight: 500;
        color: #dc3545;
        transition: all 0.2s;
    }

    .btn-delete:hover {
        background: #dc3545;
        color: white;
    }

    .btn-submit-comment {
        background: #0d6efd;
        border: none;
        border-radius: 30px;
        padding: 0.5rem 1.25rem;
        font-weight: 600;
        color: white;
        transition: all 0.2s;
    }

    .btn-submit-comment:hover {
        background: #0b5ed7;
        transform: translateY(-1px);
    }

    /* Comment Bubble */
    .comment-bubble {
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        padding: 0.75rem 1rem;
    }

    .comment-text {
        color: #e0e0e0;
        line-height: 1.5;
    }

    /* Empty State */
    .empty-state {
        background: rgba(20, 20, 30, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.05);
