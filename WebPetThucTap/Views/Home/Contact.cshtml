@{
    ViewData["Title"] = "Contact";
}

<div class="container mt-5">
    <div class="text-center">
        <h2 class="text-info fw-bold">Pet Owners Community</h2>
        <p class="text-light">Join us to share your moments, provide feedback, or report bugs.</p>
    </div>

    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="list-group shadow">

                <a href="https://discord.gg/b49baujr" target="_blank" rel="noopener noreferrer" class="list-group-item list-group-item-action bg-dark text-light border-secondary d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1 fw-bold">Discord Channel</h5>
                        <small class="text-secondary">Hang out, voice chat, and get early feature updates.</small>
                    </div>
                    <span class="badge bg-primary rounded-pill">Join Now</span>
                </a>

                <a href="#" class="list-group-item list-group-item-action bg-dark text-light border-secondary d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1 fw-bold">Source Code (GitHub)</h5>
                        <small class="text-secondary">Track project progress, contribute code, or open an Issue.</small>
                    </div>
                    <span class="badge bg-secondary rounded-pill">View Code</span>
                </a>

                <div class="list-group-item bg-dark text-light border-secondary">
                    <div class="mb-3">
                        <h5 class="mb-1 fw-bold">Development Team</h5>
                        <small class="text-secondary">Built and maintained with love for technology.</small>
                    </div>

                    <ul class="list-unstyled mb-0 ms-2">
                        <li class="mb-2">
                            <span class="badge bg-info text-dark me-2" style="width: 85px;">Dev</span>
                            <span class="text-light">Binh, Dai, Loc</span>
                        </li>
                        <li class="mb-2">
                            <span class="badge bg-warning text-dark me-2" style="width: 85px;">Dev / Test</span>
                            <span class="text-light">Anh</span>
                        </li>
                        <li>
                            <span class="badge bg-danger text-white me-2" style="width: 85px;">Security</span>
                            <span class="text-light">Thao</span>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </div>
</div>