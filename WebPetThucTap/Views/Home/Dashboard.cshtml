@model WebPetThucTap.Models.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var currentRole = (WebPetThucTap.Models.UserRole)ViewBag.CurrentUserRole;
    var expConfig = ViewBag.ExpConfig as WebPetThucTap.Models.ExpConfig;
}

<div class="admin-dashboard">
    <div class="dashboard-container">
        <!-- Header -->
        <div class="dashboard-header mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h1 class="display-5 fw-semibold mb-1">
                        <i class="bi bi-shield-lock-fill text-danger me-2"></i>
                        System Control Panel
                    </h1>
                    <p class="text-muted m-0">Manage topics, users, and system configuration</p>
                </div>
                <div class="role-badge">
                    <span class="badge bg-gradient-@(currentRole == WebPetThucTap.Models.UserRole.Dev ? "danger" : "primary") px-3 py-2 rounded-pill fw-semibold">
                        <i class="bi bi-shield-check me-1"></i> @currentRole.ToString()
                    </span>
                </div>
            </div>
            <hr class="border-secondary mt-3 mb-0" />
        </div>

        <!-- Stats Cards -->
        <div class="stats-grid row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card p-3 rounded-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase">Pending Approval</span>
                            <h3 class="mb-0 text-warning fw-bold">@Model.PendingTopics.Count</h3>
                        </div>
                        <div class="stat-icon rounded-circle p-3">
                            <i class="bi bi-clock-history fs-3 text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card p-3 rounded-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase">Members</span>
                            <h3 class="mb-0 text-info fw-bold">@Model.Users.Count(u => u.Role == WebPetThucTap.Models.UserRole.User)</h3>
                        </div>
                        <div class="stat-icon rounded-circle p-3">
                            <i class="bi bi-people fs-3 text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card p-3 rounded-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase">Administrators</span>
                            <h3 class="mb-0 text-success fw-bold">@Model.Users.Count(u => u.Role >= WebPetThucTap.Models.UserRole.Admin)</h3>
                        </div>
                        <div class="stat-icon rounded-circle p-3">
                            <i class="bi bi-shield-check fs-3 text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs Navigation -->
        <div class="tabs-wrapper mb-4">
            <ul class="nav nav-tabs border-0 gap-2" id="adminTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active fw-semibold px-4 py-2 rounded-3" id="approve-tab" data-bs-toggle="tab" data-bs-target="#approve-content" type="button">
                        <i class="bi bi-patch-check me-2"></i> Pending Topics
                        @if (Model.PendingTopics.Count > 0)
                        {
                            <span class="ms-1 badge bg-danger rounded-pill">@Model.PendingTopics.Count</span>
                        }
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-semibold px-4 py-2 rounded-3" id="users-tab" data-bs-toggle="tab" data-bs-target="#users-content" type="button">
                        <i class="bi bi-people me-2"></i> User Management
                    </button>
                </li>
                @if (currentRole == WebPetThucTap.Models.UserRole.Dev)
                {
                    <li class="nav-item">
                        <button class="nav-link fw-semibold px-4 py-2 rounded-3" id="exp-tab" data-bs-toggle="tab" data-bs-target="#exp-content" type="button">
                            <i class="bi bi-gear me-2"></i> EXP Configuration
                        </button>
                    </li>
                }
            </ul>
        </div>

        <!-- Tab Content -->
        <div class="tab-content" id="adminTabsContent">
            
            <!-- TAB 1: PENDING TOPICS -->
            <div class="tab-pane fade show active" id="approve-content">
                <div class="content-card rounded-4 overflow-hidden">
                    <div class="card-header-custom px-4 py-3 border-bottom">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-hourglass-split text-warning me-2"></i>
                            Topics Awaiting Review
                        </h5>
                    </div>
                    <div class="p-0">
                        @if (!Model.PendingTopics.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-check-circle-fill text-success fs-1 mb-3 d-block"></i>
                                <p class="text-muted mb-0">All clear! No pending topics.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table data-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Author</th>
                                            <th>Title & Content</th>
                                            <th>Date</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in Model.PendingTopics)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">@t.AuthorName</div>
                                                    <div class="small text-muted">@t.AuthorEmail</div>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold text-info">@t.Title</div>
                                                    <div class="small text-muted text-truncate" style="max-width: 320px;">@t.Content</div>
                                                </td>
                                                <td class="small text-muted">@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="text-end">
                                                    <div class="d-flex gap-2 justify-content-end">
                                                        <form asp-action="ApproveTopic" method="post" class="m-0">
                                                            <input type="hidden" name="id" value="@t.Id" />
                                                            <button type="submit" class="btn-action approve">
                                                                <i class="bi bi-check-lg me-1"></i> Approve
                                                            </button>
                                                        </form>
                                                        <form asp-action="DeleteTopic" method="post" class="m-0" onsubmit="return confirm('Delete this topic? This action cannot be undone.')">
                                                            <input type="hidden" name="id" value="@t.Id" />
                                                            <button type="submit" class="btn-action delete">
                                                                <i class="bi bi-trash3 me-1"></i> Delete
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- TAB 2: USER MANAGEMENT -->
            <div class="tab-pane fade" id="users-content">
                <div class="content-card rounded-4 overflow-hidden">
                    <div class="card-header-custom px-4 py-3 border-bottom">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-database text-info me-2"></i>
                            User Database
                        </h5>
                    </div>
                    <div class="p-0">
                        <div class="table-responsive">
                            <table class="table data-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Member</th>
                                        <th>Role</th>
                                        <th>Total EXP</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in Model.Users)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@u.Name</div>
                                                <div class="small text-muted">@u.Email</div>
                                            </td>
                                            <td>
                                                @if (u.Role == WebPetThucTap.Models.UserRole.Dev)
                                                {
                                                    <span class="role-badge dev">Developer</span>
                                                }
                                                else if (u.Role == WebPetThucTap.Models.UserRole.Admin)
                                                {
                                                    <span class="role-badge admin">Admin</span>
                                                }
                                                else
                                                {
                                                    <span class="role-badge user">User</span>
                                                }
                                            </td>
                                            <td><span class="exp-value">@u.TotalExp</span> <span class="small text-muted">exp</span></td>
                                            <td>
                                                @if (u.BannedUntil.HasValue && u.BannedUntil.Value > DateTime.Now)
                                                {
                                                    <span class="status-badge banned">
                                                        <i class="bi bi-lock-fill me-1"></i> Banned until @u.BannedUntil.Value.ToString("dd/MM HH:mm")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge active">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Active
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <div class="d-flex gap-2 justify-content-end flex-wrap">
                                                    @if (u.BannedUntil.HasValue && u.BannedUntil.Value > DateTime.Now)
                                                    {
                                                        <form asp-action="UnbanUser" method="post" class="m-0">
                                                            <input type="hidden" name="email" value="@u.Email" />
                                                            <button type="submit" class="btn-action unban">
                                                                <i class="bi bi-unlock me-1"></i> Unban
                                                            </button>
                                                        </form>
                                                    }

                                                    @if (currentRole == WebPetThucTap.Models.UserRole.Dev && u.Role != WebPetThucTap.Models.UserRole.Dev)
                                                    {
                                                        @if (u.Role == WebPetThucTap.Models.UserRole.User)
                                                        {
                                                            <a class="btn-action promote" asp-action="PromoteToAdmin" asp-route-email="@u.Email">
                                                                <i class="bi bi-arrow-up-short me-1"></i> Promote
                                                            </a>
                                                        }
                                                        else if (u.Role == WebPetThucTap.Models.UserRole.Admin)
                                                        {
                                                            <a class="btn-action demote" asp-action="DemoteToUser" asp-route-email="@u.Email">
                                                                <i class="bi bi-arrow-down-short me-1"></i> Demote
                                                            </a>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: EXP CONFIGURATION (DEV ONLY) -->
            @if (currentRole == WebPetThucTap.Models.UserRole.Dev && expConfig != null)
            {
                <div class="tab-pane fade" id="exp-content">
                    <div class="content-card rounded-4 overflow-hidden">
                        <div class="card-header-custom px-4 py-3 border-bottom">
                            <h5 class="mb-0 fw-semibold">
                                <i class="bi bi-sliders2 text-warning me-2"></i>
                                EXP Algorithm Configuration
                            </h5>
                        </div>
                        <form asp-action="UpdateExpConfig" method="post">
                            <div class="p-4">
                                <div class="row g-4">
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small text-uppercase text-muted">Base EXP (Level 1)</label>
                                        <input type="number" name="BaseExpNeeded" class="form-control config-input" value="@expConfig.BaseExpNeeded" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small text-uppercase text-muted">Multiplier</label>
                                        <input type="number" step="0.1" name="Multiplier" class="form-control config-input" value="@expConfig.Multiplier.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small text-uppercase text-muted">Levels per Title</label>
                                        <input type="number" name="LevelsPerTitle" class="form-control config-input" value="@expConfig.LevelsPerTitle" required />
                                    </div>
                                </div>
                                <div class="mt-4">
                                    <label class="form-label fw-semibold small text-uppercase text-muted">Title Hierarchy</label>
                                    <textarea name="TitlesString" class="form-control config-input" rows="3" required>@expConfig.TitlesString</textarea>
                                    <div class="form-text text-muted mt-2">
                                        <i class="bi bi-info-circle me-1"></i> Comma-separated values. System assigns titles in order (Levels 1-10 → Title 1, etc.)
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer-custom px-4 py-3 text-end border-top">
                                <button type="submit" class="btn-save">
                                    <i class="bi bi-save me-2"></i> Save Changes
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Admin Dashboard Styles - Professional & Clean */
    .admin-dashboard {
        background: transparent;
        min-height: calc(100vh - 200px);
    }

    .dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0.5rem;
    }

    /* Stats Cards */
    .stat-card {
        background: rgba(25, 25, 35, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        border-color: rgba(13, 202, 240, 0.2);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        background: rgba(13, 202, 240, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Tabs */
    .tabs-wrapper .nav-tabs {
        background: rgba(0, 0, 0, 0.3);
        padding: 0.25rem;
        border-radius: 60px;
        display: inline-flex;
        width: auto;
    }

    .tabs-wrapper .nav-link {
        background: transparent;
        border: none;
        color: #adb5bd;
        transition: all 0.2s;
        border-radius: 40px !important;
    }

    .tabs-wrapper .nav-link:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.05);
    }

    .tabs-wrapper .nav-link.active {
        background: linear-gradient(135deg, #1e2a3a, #0f1722);
        color: #0dcaf0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    /* Content Cards */
    .content-card {
        background: rgba(20, 20, 30, 0.6);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .card-header-custom {
        background: rgba(0, 0, 0, 0.3);
        border-bottom-color: rgba(255, 255, 255, 0.08);
    }

    .card-footer-custom {
        background: rgba(0, 0, 0, 0.2);
        border-top-color: rgba(255, 255, 255, 0.08);
    }

    /* Data Table */
    .data-table {
        width: 100%;
        color: #e0e0e0;
    }

    .data-table thead th {
        padding: 1rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #8b8b9b;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .data-table tbody td {
        padding: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        vertical-align: middle;
    }

    .data-table tbody tr:hover {
        background: rgba(13, 202, 240, 0.03);
    }

    /* Role Badges */
    .role-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 30px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .role-badge.dev {
        background: rgba(220, 53, 69, 0.15);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

    .role-badge.admin {
        background: rgba(25, 135, 84, 0.15);
        color: #198754;
        border: 1px solid rgba(25, 135, 84, 0.3);
    }

    .role-badge.user {
        background: rgba(108, 117, 125, 0.15);
        color: #adb5bd;
        border: 1px solid rgba(108, 117, 125, 0.3);
    }

    /* Status Badges */
    .status-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 30px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .status-badge.active {
        background: rgba(25, 135, 84, 0.12);
        color: #20c997;
    }

    .status-badge.banned {
        background: rgba(220, 53, 69, 0.12);
        color: #f87171;
    }

    .exp-value {
        font-weight: 700;
        color: #ffc107;
        font-size: 1rem;
    }

    /* Action Buttons */
    .btn-action {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 0.35rem 0.9rem;
        border-radius: 30px;
        font-size: 0.75rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s;
        border: none;
        background: transparent;
    }

    .btn-action.approve {
        background: rgba(25, 135, 84, 0.12);
        color: #198754;
        border: 1px solid rgba(25, 135, 84, 0.3);
    }

    .btn-action.approve:hover {
        background: #198754;
        color: white;
    }

    .btn-action.delete {
        background: rgba(220, 53, 69, 0.1);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

    .btn-action.delete:hover {
        background: #dc3545;
        color: white;
    }

    .btn-action.unban {
        background: rgba(13, 202, 240, 0.1);
        color: #0dcaf0;
        border: 1px solid rgba(13, 202, 240, 0.3);
    }

    .btn-action.unban:hover {
        background: #0dcaf0;
        color: #000;
    }

    .btn-action.promote {
        background: rgba(13, 110, 253, 0.1);
        color: #0d6efd;
        border: 1px solid rgba(13, 110, 253, 0.3);
    }

    .btn-action.promote:hover {
        background: #0d6efd;
        color: white;
    }

    .btn-action.demote {
        background: rgba(255, 193, 7, 0.1);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .btn-action.demote:hover {
        background: #ffc107;
        color: #000;
    }

    /* Config Inputs */
    .config-input {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
        border-radius: 12px;
        padding: 0.6rem 1rem;
        transition: all 0.2s;
    }

    .config-input:focus {
        background: rgba(0, 0, 0, 0.6);
        border-color: #0dcaf0;
        outline: none;
        box-shadow: 0 0 0 2px rgba(13, 202, 240, 0.2);
    }

    .btn-save {
        background: linear-gradient(135deg, #ffc107, #ffb300);
        border: none;
        border-radius: 40px;
        padding: 0.6rem 1.5rem;
        font-weight: 700;
        color: #1a1a2e;
        transition: all 0.2s;
    }

    .btn-save:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
    }

    /* Role Badge Gradient */
    .bg-gradient-danger {
        background: linear-gradient(135deg, #dc3545, #b91c1c);
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
    }

    /* Scrollbar */
    .table-responsive::-webkit-scrollbar {
        height: 4px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #1a1a2e;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #0dcaf0;
        border-radius: 4px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .dashboard-header h1 {
            font-size: 1.5rem;
        }
        
        .tabs-wrapper .nav-tabs {
            flex-wrap: wrap;
            border-radius: 20px;
            width: 100%;
        }
        
        .tabs-wrapper .nav-link {
            font-size: 0.8rem;
            padding: 0.5rem 1rem;
        }
        
        .data-table thead th,
        .data-table tbody td {
            padding: 0.75rem;
        }
        
        .btn-action {
            padding: 0.25rem 0.6rem;
            font-size: 0.7rem;
        }
    }
</style>