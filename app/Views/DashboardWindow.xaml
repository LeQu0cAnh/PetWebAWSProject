<Window x:Class="ZME_CloudPet.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZME Admin Dashboard" Height="450" Width="650"
        Background="#1e1e1e" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ TỪ ĐIỂN SIÊU NĂNG LỰC ZME (CLOUD DB)" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

        <DataGrid x:Name="DgApps" Grid.Row="1" Background="#252526" Foreground="White" RowBackground="#2d2d30"
                  AlternatingRowBackground="#333337" AutoGenerateColumns="False" IsReadOnly="True" 
                  SelectionChanged="DgApps_SelectionChanged" BorderBrush="#3f3f46">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1e1e1e"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="5,5,5,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Từ khóa (Keyword)" Binding="{Binding Keyword}" Width="150"/>
                <DataGridTextColumn Header="Đường dẫn hệ thống / URL Web" Binding="{Binding AppPath}" Width="350"/>
                <DataGridTextColumn Header="Phân loại" Binding="{Binding AppType}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="5">
                    <TextBlock Text="Từ khóa:" Foreground="LightGray" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtKeyword" Padding="5" Background="#2d2d30" Foreground="White" BorderBrush="#555"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="Đường dẫn file .exe hoặc Link Web:" Foreground="LightGray" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtPath" Padding="5" Background="#2d2d30" Foreground="White" BorderBrush="#555"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="Loại:" Foreground="LightGray" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbType" Padding="5" Height="28" Background="#2d2d30" SelectedIndex="0">
                        <ComboBoxItem Content="Web"/>
                        <ComboBoxItem Content="App"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnSave" Content="💾 Lưu / Cập nhật" Width="130" Height="30" Margin="5" Background="#27ae60" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click"/>
                <Button x:Name="BtnDelete" Content="🗑️ Xóa Lệnh" Width="100" Height="30" Margin="5" Background="#c0392b" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnDelete_Click"/>
                <Button x:Name="BtnRefresh" Content="🔄 Tải lại bảng" Width="100" Height="30" Margin="5" Background="#2980b9" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnRefresh_Click"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>