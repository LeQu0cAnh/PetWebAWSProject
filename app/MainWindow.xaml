<Window x:Class="ZME_CloudPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="ZME Cloud Pet" Height="400" Width="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        AllowDrop="True" 
        Drop="Window_Drop" 
        DragOver="Window_DragOver"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown">

    <Window.Resources>
        <Style x:Key="GameMenuBtn" TargetType="Button">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#0F3460" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E94560"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="ChatBubbleContainer" Background="#CC000000" CornerRadius="15" Padding="20" Margin="20,20,20,0" 
                VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="400" Visibility="Collapsed"
                MouseLeftButtonDown="ChatBubble_Click" Cursor="Hand">
            <TextBlock x:Name="ChatBubble" Text="ZME System Online! Femirins đã sẵn sàng uwu!" 
                       Foreground="White" TextWrapping="Wrap" FontSize="14" FontWeight="Bold" TextAlignment="Center"/>
        </Border>

        <Image x:Name="PetImage" gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/idle.gif" 
               Width="180" Height="180" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30"/>

        <StackPanel x:Name="InputContainer" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,5" Visibility="Collapsed">
            <TextBox x:Name="ChatInput" Width="250" Height="30" FontSize="14" Padding="5,0,0,0" 
                     BorderBrush="#555" BorderThickness="1" Background="#EEFFFFFF" KeyDown="ChatInput_KeyDown"/>
            <Button x:Name="BtnTalk" Content="🎤 Nói" Width="60" Height="30" Margin="5,0,0,0" 
                    Background="#3498db" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <Grid x:Name="GameMenuOverlay" Visibility="Collapsed" Background="#B3000000" Panel.ZIndex="100">
            <Border Background="#1A1A2E" BorderBrush="#E94560" BorderThickness="2" CornerRadius="15" Padding="20" Width="220" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="ZME SYSTEM" Foreground="#E94560" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <Button Content="⚙️ Quản Trị Hệ Thống" Click="BtnAdmin_Click" Style="{StaticResource GameMenuBtn}"/>
                    <Button Content="💬 Mở Kênh Giao Tiếp" Click="BtnChat_Click" Style="{StaticResource GameMenuBtn}"/>
                    <Button Content="❌ Đăng Xuất" Click="BtnExit_Click" Style="{StaticResource GameMenuBtn}"/>
                    <Button Content="↩ Trở Về" Click="BtnCloseMenu_Click" Style="{StaticResource GameMenuBtn}" Margin="0,15,0,0" Foreground="Gray" BorderBrush="Transparent" Background="Transparent"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>